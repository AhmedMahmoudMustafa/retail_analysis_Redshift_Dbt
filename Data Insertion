INSERT INTO retail.dim_employees (
    employee_id,
    employee_name,
    department,
    employment_type,
    hire_date,
    store_id
)
WITH RECURSIVE numbers(n) AS (
    SELECT 1
    UNION ALL
    SELECT n + 1 FROM numbers WHERE n < 10000
)
SELECT
   n AS employee_id,
   'Employee_' || n AS employee_name,
   CASE
       WHEN n % 3 = 0 THEN 'HR'
       WHEN n % 3 = 1 THEN 'Sales'
       ELSE 'Operations'
   END AS department,
   CASE
       WHEN n % 2 = 0 THEN 'Full-time'
       ELSE 'Part-time'
   END AS employment_type,
   DATEADD(day, -FLOOR(RANDOM() * 3650)::INT, CURRENT_DATE) AS hire_date,
   (n % 5) + 1 AS store_id
FROM numbers;
