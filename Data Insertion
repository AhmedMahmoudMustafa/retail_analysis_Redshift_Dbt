INSERT INTO retail.dim_products (product_id, product_name, category, price)
SELECT *
FROM (
  WITH numbers AS (
    SELECT ROW_NUMBER() OVER () AS n
    FROM 
      (SELECT 1 FROM 
        (SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL 
         UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL) t1, -- 10 rows
        (SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL 
         UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL) t2  -- 10 rows
      ) cross_10x10  -- 10 x 10 = 100 rows
    LIMIT 500
  )
  SELECT
    n AS product_id,
    'Product_' || n AS product_name,
    CASE
      WHEN n % 3 = 0 THEN 'Electronics'
      WHEN n % 3 = 1 THEN 'Clothing'
      ELSE 'Home & Kitchen'
    END AS category,
    ROUND(RANDOM() * 500 + 5, 2) AS price
  FROM numbers
) AS fake_products;



