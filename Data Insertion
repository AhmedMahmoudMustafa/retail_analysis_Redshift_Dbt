INSERT INTO retail.dim_customers (customer_id, customer_name, email, region, signup_date)
WITH numbers AS (
  SELECT ROW_NUMBER() OVER() AS id
  FROM (
    SELECT 1 FROM 
      (SELECT 1 FROM retail.dim_time LIMIT 100) t1, -- Any table with >100 rows
      (SELECT 1 FROM retail.dim_products LIMIT 100) t2
  ) AS gen_rows
  LIMIT 100000
)
SELECT
  id AS customer_id,
  'Customer_' || id AS customer_name,
  'customer' || id || '@example.com' AS email,
  CASE
      WHEN id % 4 = 0 THEN 'North'
      WHEN id % 4 = 1 THEN 'South'
      WHEN id % 4 = 2 THEN 'East'
      ELSE 'West'
  END AS region,
  DATEADD(day, CAST(-FLOOR(RANDOM() * 3650) AS INT), CURRENT_DATE) AS signup_date
FROM numbers;




