INSERT INTO retail.dim_stores (store_id, store_name, location, manager_name)
WITH gen_rows AS (
  SELECT ROW_NUMBER() OVER() AS rn
  FROM (
    SELECT 1 FROM 
      (SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL
       UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL) a,  -- 10 rows
      (SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL
       UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL UNION ALL SELECT NULL) b   -- 10 rows
  ) AS base
  LIMIT 100
)
SELECT
   rn AS store_id,
   'Store_' || rn AS store_name,
   CASE
       WHEN rn % 4 = 0 THEN 'New York'
       WHEN rn % 4 = 1 THEN 'Los Angeles'
       WHEN rn % 4 = 2 THEN 'Chicago'
       ELSE 'Houston'
   END AS location,
   'manager_name_' || rn AS manager_name
FROM gen_rows;


