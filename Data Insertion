CREATE TEMP TABLE temp_date_series AS
WITH RECURSIVE dates(n, date_id) AS (
    SELECT 0::INT, CURRENT_DATE::DATE
    UNION ALL
    SELECT n + 1, (date_id - INTERVAL '1 day')::DATE
    FROM dates
    WHERE n + 1 < 5000
)
SELECT date_id FROM dates;


-- Step 2: Insert into retail.dim_time
INSERT INTO retail.dim_time (date_id, year, quarter, month, day, day_of_week)
SELECT
   date_id,
   EXTRACT(YEAR FROM date_id) AS year,
   EXTRACT(QUARTER FROM date_id) AS quarter,
   EXTRACT(MONTH FROM date_id) AS month,
   EXTRACT(DAY FROM date_id) AS day,
   TRIM(TO_CHAR(date_id, 'Day')) AS day_of_week
FROM temp_date_series;


